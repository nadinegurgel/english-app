# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL (used by docker compose and by the API)
POSTGRES_USER=english_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=english_app

# Connection string used when the API runs on your machine (npm run dev).
# Inside docker compose the API connects to the "db" service instead.
DATABASE_URL=postgres://english_app:change-me@localhost:5432/english_app

# API
PORT=3000

# Claude API key for generating example sentences (https://console.anthropic.com).
# Optional until the "Add words" stage.
ANTHROPIC_API_KEY=

# Shared sentence dictionary. The AI is only asked for a new sentence while a word has fewer
# than these; after that, stored sentences are reused.
EXAMPLE_SENTENCES_PER_WORD=5
QUIZ_SENTENCES_PER_WORD=8
